# Copy this file to .env.local (or run `vercel env pull .env.local` after
# connecting a Neon Postgres database via the Vercel dashboard's Storage tab)
# and fill in real values.
#
# The feedback API route (app/api/feedback/route.ts) only reads DATABASE_URL,
# via @neondatabase/serverless. The other vars below are also injected by the
# Vercel <-> Neon integration but aren't required by this app.

DATABASE_URL=
DATABASE_URL_UNPOOLED=
